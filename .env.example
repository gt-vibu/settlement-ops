# SettlementOps - environment template. Values here are PLACEHOLDERS ONLY.
# Never commit a real .env (see .gitignore).

# ---------------------------------------------------------------- runtime
# development | test | demo | production
# In production the process REFUSES to start with AUTH_ADAPTER=demo or
# DEMO_SCENARIOS_ENABLED=true. Those are not warnings; they are startup failures.
NODE_ENV=development

# ------------------------------------------------------------- databases
# Application role. Has no CONNECT privilege on settlementops_eval.
DATABASE_URL=postgres://settlementops_app:CHANGE_ME@localhost:5434/settlementops_app

# Migration role. Used ONLY by the migration command, never at runtime.
MIGRATION_DATABASE_URL=postgres://settlementops_migrator:CHANGE_ME@localhost:5434/settlementops_app

# EVAL_DATABASE_URL IS DELIBERATELY ABSENT.
# It belongs to the evaluation harness only (decision D5). apps/api and apps/worker refuse
# to start if it is present in their environment, and the application role cannot connect
# to that database in any case. Export it in the shell that runs `pnpm eval:*`, nowhere else.

# ------------------------------------------------------------------- api
AUTH_ADAPTER=demo
API_PORT=3000
LOG_LEVEL=info

# ------------------------------------------------------------------- ai
# Master kill switch. With it false there is no code path from a route to a model at all:
# the dispatcher is never constructed, and investigations escalate with MODEL_DISABLED.
AI_INVESTIGATION_ENABLED=false

# Required when AI_INVESTIGATION_ENABLED=true. There is no default model: a silently
# chosen one would produce results nobody could reproduce.
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b-instruct-q4_K_M

# Optional but strongly recommended. Ollama tags are MUTABLE, so the digest is the real
# identity. Set it and a silently re-pulled model fails loudly instead of quietly changing
# behaviour. The frozen experiment ran against the digest below.
OLLAMA_MODEL_DIGEST=357c53fb659c5076de1d65ccb0b397446227b71a42be9d1603d46168015c9e4b

MODEL_TEMPERATURE=0
MODEL_TIMEOUT_SECONDS=60
MODEL_MAX_OUTPUT_TOKENS=512

# ---------------------------------------------------------------- agent
AGENT_MAX_TOOL_CALLS=8
AGENT_MAX_STEPS=8
AGENT_MAX_WALLCLOCK_SECONDS=120

# ------------------------------------------------------------------ demo
# Demo scenario routes. Cannot be enabled in production.
DEMO_SCENARIOS_ENABLED=true
