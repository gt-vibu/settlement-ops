{
  "name": "settlementops",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.19.0",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --exclude \"tests/integration/**\"",
    "test:watch": "vitest",
    "check:size": "tsx scripts/check-file-size.ts",
    "check:deps": "tsx scripts/check-deps.ts",
    "check:money": "tsx scripts/check-money-safety.ts",
    "check:secrets": "tsx scripts/check-secrets.ts",
    "check:ui": "tsx scripts/check-ui-boundary.ts",
    "build": "tsc -p tsconfig.build.json",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:unit && pnpm check:size && pnpm check:deps && pnpm check:money && pnpm check:secrets && pnpm check:ui && pnpm build",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:migrate": "tsx scripts/migrate.ts",
    "audit": "pnpm audit --audit-level=high",
    "test:integration": "vitest run tests/integration",
    "eval:db:migrate": "tsx scripts/eval/migrate-eval.ts",
    "eval:generate": "tsx scripts/eval/generate-dataset.ts",
    "eval:leakage": "tsx scripts/eval/leakage-audit.ts",
    "eval:run": "tsx scripts/eval/run-benchmark.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "eslint": "^9.17.0",
    "pg": "^8.23.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
